{
  "name": "personal-academic-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "独立学术主页与 Markdown 博客，部署到 GitHub Pages",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "new:post": "node scripts/new-post.mjs",
    "publish": "node scripts/publish.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mdit/plugin-katex-slim": "1.1.1",
    "gray-matter": "4.0.3",
    "highlight.js": "11.11.1",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-container": "4.0.0",
    "markdown-it-footnote": "4.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
